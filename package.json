{
  "name": "central-receita-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3011",
    "build": "node scripts/build-sites.mjs",
    "build:static": "next build --webpack",
    "build:sites": "npm run build",
